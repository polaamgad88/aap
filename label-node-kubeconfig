---
- name: Label infra and storage nodes
  hosts: localhost
  gather_facts: false
  connection: local

  collections:
    - kubernetes.core

  vars:
    validate_certs: false
    kubeconfig_path: "/tmp/kubeconfig"

    cluster_id: "d29"

    infra_nodes:
      - "ocp-{{ cluster_id }}-inf01"
      - "ocp-{{ cluster_id }}-inf02"

    storage_nodes:
      - "ocp-{{ cluster_id }}-odf01"
      - "ocp-{{ cluster_id }}-odf02"
      - "ocp-{{ cluster_id }}-odf03"

  tasks:
    - name: Fail if kubeconfig_b64 is empty
      ansible.builtin.fail:
        msg: "kubeconfig_b64 is empty. Paste base64 kubeconfig into the AAP Survey."
      when: kubeconfig_b64 is not defined or kubeconfig_b64 | trim == ""

    - name: Write kubeconfig file from base64 survey value
      ansible.builtin.copy:
        dest: "{{ kubeconfig_path }}"
        content: "{{ kubeconfig_b64 | trim | b64decode }}"
        mode: "0600"

    - name: List all nodes before labeling
      kubernetes.core.k8s_info:
        kubeconfig: "{{ kubeconfig_path }}"
        validate_certs: "{{ validate_certs }}"
        api_version: v1
        kind: Node
      register: nodes_before

    - name: Show detected nodes
      ansible.builtin.debug:
        msg: "{{ nodes_before.resources | map(attribute='metadata.name') | list }}"

    - name: Label infra nodes
      kubernetes.core.k8s:
        kubeconfig: "{{ kubeconfig_path }}"
        validate_certs: "{{ validate_certs }}"
        state: patched
        api_version: v1
        kind: Node
        name: "{{ item }}"
        definition:
          metadata:
            labels:
              node-role.kubernetes.io/infra: ""
      loop: "{{ infra_nodes }}"

    - name: Label storage nodes
      kubernetes.core.k8s:
        kubeconfig: "{{ kubeconfig_path }}"
        validate_certs: "{{ validate_certs }}"
        state: patched
        api_version: v1
        kind: Node
        name: "{{ item }}"
        definition:
          metadata:
            labels:
              node-role.kubernetes.io/storage: ""
              cluster.ocs.openshift.io/openshift-storage: ""
      loop: "{{ storage_nodes }}"

    - name: List all nodes after labeling
      kubernetes.core.k8s_info:
        kubeconfig: "{{ kubeconfig_path }}"
        validate_certs: "{{ validate_certs }}"
        api_version: v1
        kind: Node
      register: nodes_after

    - name: Show infra and storage node labels
      ansible.builtin.debug:
        msg: >-
          {{
            nodes_after.resources
            | selectattr('metadata.name', 'in', infra_nodes + storage_nodes)
            | map(attribute='metadata')
            | list
          }}
